{
  "name": "personal-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "build": "npx ng build --configuration production",
    "watch": "npx ng build --watch --configuration development",
    "test": "npx ng test",
    "server": "node server.js",
    "dev": "concurrently \"npx ng serve --port 4204\" \"npm run server\"",
    "dev:server": "nodemon server.js --port 3008",
    "lint": "npx ng lint",
    "deploy": "npx ng build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "init-about-section": "node init-about-section.js",
    "init-firestore-collections": "node init-firestore-collections.js",
    "setup-portfolio-firestore": "node setup-portfolio-firestore.js",
    "test-firebase-connection": "node test-firebase-connection.js",
    "verify-firestore-structure": "node verify-firestore-structure.js",
    "test-firestore-data": "node test-firestore-data.js",
    "firestore:setup": "node firestore-setup/setupPortfolioData.js",
    "firestore:setup:hero": "node firestore-setup/setupHeroData.js",
    "firestore:setup:about": "node firestore-setup/setupAboutData.js",
    "firestore:setup:skills": "node firestore-setup/setupSkillsData.js",
    "firestore:setup:projects": "node firestore-setup/setupProjectsData.js",
    "firestore:setup:experience": "node firestore-setup/setupExperienceData.js",
    "firestore:setup:education": "node firestore-setup/setupEducationData.js",
    "firestore:setup:certifications": "node firestore-setup/setupCertificationsData.js",
    "firestore:setup:contact": "node firestore-setup/setupContactData.js",
    "firestore:setup:reviews": "node firestore-setup/setupReviewsData.js",
    "firestore:setup:projects:corrected": "node firestore-setup/setupProjectsDataCorrected.js",
    "firestore:setup:skills:corrected": "node firestore-setup/setupSkillsDataCorrected.js",
    "firestore:verify:projects": "node verify-projects-data.js",
    "firestore:verify:reviews": "node firestore-setup/verifyReviewsData.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "canvas-confetti": "^1.9.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^12.3.0",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.35.1",
    "gsap": "^3.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.2.19",
    "@angular/compiler-cli": "^19.0.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.3.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "8.40.0"
  }
}