rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to adminlogin collection only for login verification
    match /adminlogin/{document} {
      allow read: if request.auth != null || true;  // Allow read for login verification (public read for login)
      allow write: if false; // No write access from client
    }
    
    // Allow read access to config collection for public data
    match /config/{document} {
      allow read: if true;  // Public read access for config data
      allow write: if request.auth != null; // Only authenticated users can write
    }
    
    // Allow read access to skills collection
    match /skills/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to projects collection
    match /projects/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to experience collection
    match /experience/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to education collection
    match /education/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to certifications collection
    match /certifications/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to contact-messages collection
    match /contact-messages/{document} {
      allow read: if request.auth != null; // Only authenticated users can read
      allow write: if true; // Allow public write for contact form
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}