rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to adminlogin collection only for login verification
    match /adminlogin/{document} {
      allow read: if request.auth != null || true;  // Allow read for login verification (public read for login)
      allow write: if false; // No write access from client
    }
    
    // Allow read access to config collection for public data
    match /config/{document} {
      allow read: if true;  // Public read access for config data
      allow write: if request.auth != null; // Only authenticated users can write
    }
    
    // Allow read access to skillsinfo collection
    match /skillsinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to projectsinfo collection
    match /projectsinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to experienceinfo collection
    match /experienceinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to educationinfo collection
    match /educationinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to certificationinfo collection
    match /certificationinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to aboutmeinfo collection
    match /aboutmeinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to heroinfo collection
    match /heroinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to contactinfo collection
    match /contactinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to reviewsinfo collection
    match /reviewsinfo/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow read access to contact-messages collection
    match /contact-messages/{document} {
      allow read: if request.auth != null; // Only authenticated users can read
      allow write: if true; // Allow public write for contact form
    }
    
    // Deny access to all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}